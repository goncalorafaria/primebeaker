ARG BASE_IMAGE=prime-rl-base:01KZVDND2PYP538F5JSGJ469EC
FROM ${BASE_IMAGE}

ARG PRIMEBEAKER_VERSION=0.3.0
ARG JTC_VERSION=0.2.0
USER root

# Application code comes exclusively from released, version-pinned PyPI wheels.
# The parent image owns the tested CUDA/Torch/vLLM/Prime-RL binary stack.
RUN python3 -m pip install --no-cache-dir --index-url https://pypi.org/simple \
      "primebeaker[runtime]==${PRIMEBEAKER_VERSION}" \
      "jtc[harness]==${JTC_VERSION}" \
    && python3 -c "from importlib.metadata import version; assert version(\"primebeaker\") == \"${PRIMEBEAKER_VERSION}\"; assert version(\"jtc\") == \"${JTC_VERSION}\"; assert version(\"literegistry\") == \"1.0.48\"; assert version(\"literegistry-tool-client\") == \"0.1.0\"; assert version(\"verifiers\") == \"0.2.1\"" \
    && python3 -c "import primebeaker, datadev, jtceval, jtc_data_commons, jtcflow; from primebeaker.environments import ENVIRONMENTS, load_environment_module; [load_environment_module(name) for name in ENVIRONMENTS]" \
    && python3 -c "from jtc_data_commons.workflows import load_workflow; load_workflow(\"verifier-tool-use\")" \
    && python3 -c "from prime_rl.configs.trainer import AdamWConfig; assert \"eps\" in AdamWConfig.model_fields" \
    && python3 -m primebeaker.multinode --help >/dev/null \
    && command -v jtc \
    && command -v jtc-workflow \
    && command -v datadev \
    && command -v jtceval \
    && command -v rl \
    && command -v sft \
    && command -v inference \
    && command -v orchestrator \
    && command -v vllm-router \
    && command -v beaker

LABEL org.opencontainers.image.title="PrimeBeaker + JTC PyPI runtime" \
      org.opencontainers.image.version="${PRIMEBEAKER_VERSION}" \
      ai2.jtc.version="${JTC_VERSION}" \
      ai2.python.packages.source="pypi"

WORKDIR /weka
ENTRYPOINT []
CMD ["/bin/bash"]
