{
  "version": "v2",
  "description": "Step430 Jupiter-only BF16 TP4 seeds1-5; Saturn baseline settings; eval",
  "budget": "ai2/oe-omai",
  "tasks": [
    {
      "name": "eval-430-jupiter-five-seeds",
      "image": {
        "docker": "nvidia/cuda:13.0.1-cudnn-devel-ubuntu24.04"
