      "envVars": [
        {
          "name": "SERPER_API_KEY",
          "secret": "SERPER_API_KEY"
        },
        {
          "name": "JINA_API_KEY",
          "secret": "JINA_API_KEY"
        },
        {
          "name": "HF_TOKEN",
          "secret": "HF_TOKEN"
        },
        {
          "name": "CHECKPOINT_PATH",
          "value": "/weka/gfaria/search-agent-repr/outputs/search-agent-mc32-resume400-to450-20261103/search-agent-mc32-resume400-to450-20261103/checkpoints/step_430"
        },
        {
          "name": "RUN_CONFIG_DIR",
          "value": "/weka/gfaria/search-agent-repr/outputs/search-agent-mc32-resume400-to450-20261103/configs"
        },
        {
          "name": "MODEL_PORT",
          "value": "42103"
        },
        {
          "name": "SEARCH_PORT",
          "value": "42101"
        },
        {
          "name": "GATEWAY_PORT",
          "value": "42102"
        },
        {
          "name": "EVAL_OUTPUT_DIR",
          "value": "/weka/gfaria/search-agent-repr/evals/frontier-structured430-five-seeds-jupiter-20261105/step430"
        },
        {
          "name": "MODEL_PATH",
          "value": "/weka/gfaria/search-agent-repr/evals/frontier-science-step430-256k-bf16-web-v2-saturn-three-seeds/hf-checkpoint"
